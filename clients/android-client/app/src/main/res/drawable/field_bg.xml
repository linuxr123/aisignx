<?xml version="1.0" encoding="utf-8"?>
<!-- Input and button background with a visible focus ring for D-pad navigation. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setup_card" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/setup_card" />
            <stroke android:width="1dp" android:color="@color/setup_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
