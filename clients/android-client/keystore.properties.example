# AiSignX Android release signing
#
# Copy this file to "keystore.properties" (same folder), fill in real values,
# then run:  .\gradlew.bat assembleRelease
# Without keystore.properties the release APK is built unsigned.
#
# Use the SAME key forever. Android only installs an update that is signed with
# the key of the installed app. If the key is lost, every device must be
# uninstalled and set up again. keystore.properties and keystores are gitignored.

# Path to the keystore, relative to clients/android-client/app/
storeFile=CHANGE_ME.jks
storePassword=CHANGE_ME
keyAlias=aisignx
keyPassword=CHANGE_ME

# Create a new keystore (only for a new fleet):
#   keytool -genkeypair -v -keystore aisignx-release.jks -alias aisignx -keyalg RSA -keysize 3072 -validity 10000
