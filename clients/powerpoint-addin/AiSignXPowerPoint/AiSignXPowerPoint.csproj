<?xml version="1.0" encoding="utf-8"?>
<!--
  AiSignX for PowerPoint: a VSTO add-in (.NET Framework 4.8).

  Building the add-in package (.vsto and .dll.manifest) and F5 debugging need Visual Studio's
  "Office/SharePoint development" workload (component "Office Developer Tools for Visual
  Studio"). Without it this project still compiles the DLL, so code errors show up, and the
  build prints a warning; see ../README.md.

  The manifests must be signed. The certificate is per developer and never committed: run
  ../tools/New-DevCert.ps1 once, which writes signing.local.props (gitignored) next to this file.
-->
<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <ProjectTypeGuids>{BAA0C2D2-18E2-41B9-852F-F413020CAA33};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{554897F2-AF95-4D54-8796-5B88101CBF90}</ProjectGuid>
    <OutputType>Library</OutputType>
    <NoStandardLibraries>false</NoStandardLibraries>
    <RootNamespace>AiSignXPowerPoint</RootNamespace>
    <AssemblyName>AiSignXPowerPoint</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>VSTO40;UseOfficeInterop</DefineConstants>
    <ResolveComReferenceSilent>true</ResolveComReferenceSilent>
    <IsWebBootstrapper>False</IsWebBootstrapper>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <PublishUrl>publish\</PublishUrl>
    <InstallUrl />
    <TargetCulture>en</TargetCulture>
    <ApplicationVersion>3.0.2.0</ApplicationVersion>
    <ApplicationIcon>Resources\AiSignX.ico</ApplicationIcon>
    <AutoIncrementApplicationRevision>true</AutoIncrementApplicationRevision>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>days</UpdateIntervalUnits>
    <ProductName>AiSignX for PowerPoint</ProductName>
    <PublisherName>AiSignX</PublisherName>
    <SupportUrl>https://github.com/linuxr123/aisignx</SupportUrl>
    <FriendlyName>AiSignX for PowerPoint</FriendlyName>
    <OfficeApplicationDescription>Export the presentation as a video and upload it to AiSignX.</OfficeApplicationDescription>
    <LoadBehavior>3</LoadBehavior>
    <OfficeApplication>PowerPoint</OfficeApplication>
  </PropertyGroup>
  <ItemGroup>
    <BootstrapperPackage Include=".NETFramework,Version=v4.8">
      <Visible>False</Visible>
      <ProductName>Microsoft .NET Framework 4.8 %28x86 and x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.VSTORuntime.4.0">
      <Visible>False</Visible>
      <ProductName>Microsoft Visual Studio 2010 Tools for Office Runtime %28x86 and x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <!-- Visual Studio Tools for Office runtime (installed with Office; Private=False: never copied). -->
  <ItemGroup>
    <Reference Include="Microsoft.Office.Tools.v4.0.Framework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Tools.Applications.Runtime, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Common.v4.0.Utilities, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Common, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Office primary interop assemblies; the types used are embedded, so any Office 2013+ works. -->
  <ItemGroup>
    <Reference Include="Office, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c">
      <Private>False</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.PowerPoint, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c">
      <Private>False</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AiSignXRibbon.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="AiSignXRibbon.Designer.cs">
      <DependentUpon>AiSignXRibbon.cs</DependentUpon>
    </Compile>
    <Compile Include="Api\ApiErrors.cs" />
    <Compile Include="Api\ApiException.cs" />
    <Compile Include="Api\CertificatePin.cs" />
    <Compile Include="Api\MediaApiClient.cs" />
    <Compile Include="Api\MediaItem.cs" />
    <Compile Include="Api\ProgressFileContent.cs" />
    <Compile Include="Api\ServerAddress.cs" />
    <Compile Include="Export\OleMessageFilter.cs" />
    <Compile Include="Export\TempFiles.cs" />
    <Compile Include="Export\VideoExporter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Settings\PresentationOptions.cs" />
    <Compile Include="Settings\UserSettings.cs" />
    <Compile Include="ThisAddIn.cs">
      <SubType>Code</SubType>
    </Compile>
    <None Include="ThisAddIn.Designer.xml">
      <DependentUpon>ThisAddIn.cs</DependentUpon>
    </None>
    <Compile Include="ThisAddIn.Designer.cs">
      <DependentUpon>ThisAddIn.Designer.xml</DependentUpon>
    </Compile>
    <Compile Include="Resources\Icons.cs" />
    <EmbeddedResource Include="Resources\AiSignX.ico" />
    <EmbeddedResource Include="Resources\ribbon-upload-32.png" />
    <EmbeddedResource Include="Resources\ribbon-upload-64.png" />
    <Compile Include="UI\MediaPickerForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="UI\UploadForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="UI\UploadForm.Actions.cs">
      <DependentUpon>UploadForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <OfficeToolsTargets>$(VSToolsPath)\OfficeTools\Microsoft.VisualStudio.Tools.Office.targets</OfficeToolsTargets>
  </PropertyGroup>
  <!-- The VSTO runtime reference assemblies ship with the Office workload of Visual Studio; a plain
       msbuild (outside a Developer Prompt) does not search that folder, so add it. -->
  <PropertyGroup>
    <VstoReferenceAssemblies>$(MSBuildToolsPath)\..\..\..\Common7\IDE\ReferenceAssemblies\v4.0</VstoReferenceAssemblies>
    <ReferencePath Condition="Exists('$(VstoReferenceAssemblies)')">$(ReferencePath);$(VstoReferenceAssemblies)</ReferencePath>
  </PropertyGroup>
  <!-- Manifest signing: signing.local.props (gitignored, made by tools/New-DevCert.ps1) sets
       ManifestCertificateThumbprint and, optionally, ManifestKeyFile. -->
  <Import Project="signing.local.props" Condition="Exists('signing.local.props')" />
  <PropertyGroup Condition="'$(ManifestCertificateThumbprint)' != ''">
    <SignManifests>true</SignManifests>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(OfficeToolsTargets)" Condition="Exists('$(OfficeToolsTargets)')" />
  <Target Name="AiSignXCheckToolchain" BeforeTargets="Build">
    <Warning Condition="!Exists('$(OfficeToolsTargets)')" Text="Office Developer Tools are not installed, so only the DLL was built (no .vsto package, no F5 debugging). In the Visual Studio Installer, add the 'Office/SharePoint development' workload (Microsoft.VisualStudio.Workload.Office). See clients/powerpoint-addin/README.md." />
    <Error Condition="Exists('$(OfficeToolsTargets)') And '$(ManifestCertificateThumbprint)' == ''" Text="No manifest signing certificate. Run clients/powerpoint-addin/tools/New-DevCert.ps1 once (it writes AiSignXPowerPoint/signing.local.props, which is never committed)." />
  </Target>
  <ProjectExtensions>
    <VisualStudio>
      <FlavorProperties GUID="{BAA0C2D2-18E2-41B9-852F-F413020CAA33}">
        <ProjectProperties HostName="PowerPoint" HostPackage="{29A7B9D7-A7F1-4328-8EF0-6B2D1A56B2C1}" OfficeVersion="15.0" VstxVersion="4.0" ApplicationType="PowerPoint" Language="cs" TemplatesPath="" DebugInfoExeName="#Software\Microsoft\Office\16.0\PowerPoint\InstallRoot\Path#powerpnt.exe" AddItemTemplatesGuid="{51063C3A-E220-4D12-8922-BDA915ACD783}" />
        <Host Name="PowerPoint" GeneratedCodeNamespace="AiSignXPowerPoint" IconIndex="0">
          <HostItem Name="ThisAddIn" Code="ThisAddIn.cs" CanonicalName="AddIn" CanActivate="false" IconIndex="1" Blueprint="ThisAddIn.Designer.xml" GeneratedCode="ThisAddIn.Designer.cs" />
        </Host>
      </FlavorProperties>
    </VisualStudio>
  </ProjectExtensions>
</Project>
