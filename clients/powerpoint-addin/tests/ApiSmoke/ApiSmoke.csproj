<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console smoke test for the add-in's API layer against a real AiSignX server.
       Builds without Office or Visual Studio (needs the .NET SDK; runs on .NET Framework 4.8). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ApiSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Compile Include="..\..\AiSignXPowerPoint\Api\*.cs" Link="Api\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
