# Copy to server/.env and adjust. Never commit the real .env file.

# Session signing key. If unset, a random key is generated once and stored in server/instance/secret_key.
# AISIGNX_SECRET_KEY=

# Database URL. Default: SQLite file at server/instance/aisignx.db
# AISIGNX_DATABASE_URL=postgresql+psycopg://user:password@localhost/aisignx

# Set to 1 when serving over HTTPS so cookies are marked Secure.
# AISIGNX_SECURE_COOKIES=0

# Where uploaded media is stored (default: server/uploads) and the largest upload in MB.
# AISIGNX_UPLOAD_DIR=
# AISIGNX_MAX_UPLOAD_MB=2048

# Paths to ffmpeg and ffprobe if they aren't on the PATH.
# AISIGNX_FFMPEG=C:\ffmpeg\ffmpeg.exe
# AISIGNX_FFPROBE=C:\ffmpeg\ffprobe.exe

# Browser used for web page screenshots (default: auto-detect Edge, Chrome or Chromium).
# AISIGNX_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# AISIGNX_WEBSHOT_TIMEOUT=45

# Most screens that can hold a live-update connection at the same time (default: 50).
# "flask --app wsgi serve" starts this many threads plus 16, so raise it if you have more screens.
# AISIGNX_MAX_STREAMS=50

# Number of reverse proxies in front of AiSignX (nginx, Caddy, IIS). Set to 1 behind one proxy so
# screen IP addresses and https links are read from the X-Forwarded-* headers. Leave at 0 when
# clients connect directly; otherwise anyone could fake those headers.
# AISIGNX_PROXY_HOPS=0

# Background check that pushes schedule starts and ends to screens about once a minute (default: 1).
# Set to 0 to turn it off; screens then pick up schedule changes through their 30-second heartbeat.
# AISIGNX_SCHEDULE_TICKER=1
