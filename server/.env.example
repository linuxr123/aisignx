# Copy to server/.env and adjust. Never commit the real .env file.

# Session signing key. If unset, a random key is generated once and stored in server/instance/secret_key.
# AISIGNX_SECRET_KEY=

# Database URL. Default: SQLite file at server/instance/aisignx.db
# AISIGNX_DATABASE_URL=postgresql+psycopg://user:password@localhost/aisignx

# Set to 1 when serving over HTTPS so cookies are marked Secure.
# AISIGNX_SECURE_COOKIES=0
