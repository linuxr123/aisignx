{
  "key": "clock",
  "name": "Clock",
  "version": "3.0.0",
  "icon": "clock",
  "description": "A full-screen clock with date, in five styles. Works offline.",
  "render": "frame",
  "files": ["index.html", "clock.js", "main.js", "style.css",
            "themes/minimal.js", "themes/analog-classic.js", "themes/flip-clock.js",
            "themes/word-clock.js"],
  "default_duration": 10,
  "ends_itself": false,
  "schema": [
    {"name": "theme", "type": "select", "label": "Style", "default": "minimal-dark",
     "options": [{"value": "minimal-dark", "label": "Minimal, dark"},
                 {"value": "minimal-light", "label": "Minimal, light"},
                 {"value": "analog-classic", "label": "Analog"},
                 {"value": "flip-clock", "label": "Flip clock"},
                 {"value": "word-clock", "label": "Word clock (English)"}]},
    {"name": "format", "type": "select", "label": "Hours", "default": "24h",
     "options": [{"value": "24h", "label": "24-hour (14:30)"},
                 {"value": "12h", "label": "12-hour (2:30 PM)"}]},
    {"name": "seconds", "type": "boolean", "label": "Show seconds", "default": true},
    {"name": "show_date", "type": "boolean", "label": "Show the date", "default": true},
    {"name": "date_style", "type": "select", "label": "Date style", "default": "long",
     "show_if": {"show_date": true},
     "options": [{"value": "long", "label": "Long (Monday, 14 November 2026)"},
                 {"value": "short", "label": "Short (Mon, 14 Nov)"}]},
    {"name": "timezone", "type": "timezone", "label": "Time zone",
     "help": "Leave empty to use the organization's time zone."},
    {"name": "label", "type": "string", "label": "Label", "max_length": 60,
     "help": "Optional caption, for example a city name."}
  ],
  "attribution": ""
}
